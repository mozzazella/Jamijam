body {
    margin: 0;
    padding: 30px 15px;

    min-height: 100vh;

    background-image: url("background.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;

    font-family: Arial, sans-serif;
    color: #40566b;
}

.message-box {
    width: 90%;
    max-width: 650px;

    margin: 0 auto;

    background: white;

    padding: 25px;

    border-radius: 20px;

    box-shadow: 0 5px 20px rgba(0,0,0,0.15);
}

h1 {
    text-align: center;
    color: #428dcc;
}

p {
    font-size: 16px;
    line-height: 1.7;
}

audio {
    width: 100%;
    margin-top: 20px;
}
